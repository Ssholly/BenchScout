{
  "name": "labpro-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:deploy": "prisma migrate deploy",
    "acceptance": "node scripts/run-acceptance.cjs",
    "documents:migrate": "node scripts/migrate-private-documents.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "next": "^16.2.5",
    "nodemailer": "^8.0.10",
    "pdf-parse": "^2.4.5",
    "pdf-ts": "^0.0.2",
    "pdf2json": "^4.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.19.3",
    "typescript": "^5"
  }
}
