DATABASE_URL="postgresql://postgres:postgres@localhost:5432/benchscout"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional exact hostnames/IPs for local phone testing, comma-separated; no wildcard.
DEV_ALLOWED_ORIGINS=""
# Generate three independent secrets of at least 32 characters.
ADMIN_SECRET=""
CRON_SECRET=""
SALARY_OWNER_SECRET=""
# A separate Vercel Blob store configured for PRIVATE access is required.
BLOB_PRIVATE_READ_WRITE_TOKEN=""
# Separate PRIVATE store; enable on testing only after the synthetic recovery drill.
DOCUMENT_BACKUP_ENABLED="false"
BLOB_BACKUP_READ_WRITE_TOKEN=""
# Exactly 64 hexadecimal characters (32 random bytes); keep a separate recovery copy.
DOCUMENT_BACKUP_ENCRYPTION_KEY=""
# Set only to an operator-approved alert inbox. No file data is sent.
DOCUMENT_BACKUP_ALERT_EMAIL=""
# Enables administrator-only synthetic loss/restore tool; never enable on Production.
DOCUMENT_BACKUP_TEST_MODE="false"
# Only needed to migrate/delete objects in the old PUBLIC store.
BLOB_READ_WRITE_TOKEN=""
EMAIL_FROM="BenchScout <notifications@your-verified-domain.example>"
RESEND_API_KEY=""
# Optional custom SMTP (takes precedence over Resend/Gmail when SMTP_HOST is set).
# Loopback SMTP can capture acceptance-test mail without external delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Optional email fallback:
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Optional external job provider and AI extraction/letters:
APIFY_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
