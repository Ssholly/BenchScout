generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

model User {
  id                String       @id @default(cuid())
  name              String
  avatarUrl         String?
  email             String       @unique
  
  // 🚀 Licensure & Compliance Fields (De-duplicated & Merged)
  licenseUrl        String?      // Link to MLSCN practicing license
  provisionalUrl    String?      // Provisional license specifically for interns
  degreeUrl         String?      // Link to B.MLS degree
  licenseReviewReference String?
  licenseReviewedAt DateTime?
  licenseNumber     String?
  mlscnNumber       String?      // Extracted RA/Intern Number
  licenseExpiry     DateTime?
  cpdPoints         Int          @default(0)
  isLicenseVerified Boolean      @default(false)
  isVerified        Boolean      @default(false) // Blocks login until email is confirmed. ALSO acts as the general verification flag.
  
  scanTime          String       @default("09:00")
  scanDays          String       @default("Monday,Tuesday,Wednesday,Thursday,Friday")
  scanTimezone      String       @default("Africa/Lagos")
  lastScheduledAt   DateTime?
  scanLeaseUntil    DateTime?
  careerPhase       String       @default("licensed") // "internship" or "licensed"
  candidateProfile  Json         @default("{}")
  statementOfResultUrl String?
  placementLetterUrl String?
  certificateUrl    String?

  password          String       // We will hash this in the backend
  location          String       @default("All Nigeria")
  keywords          String?      // The AI will populate this from the resume
  resumeUrl         String?      // Link to their uploaded PDF
  cvParsedText      String?      // Hidden text extracted for the AI Cover Letter Engine
  minScore          Int          @default(70)
  createdAt         DateTime     @default(now())
  
  // ==========================================
  // 🚀 PILLAR 3: AUTONOMOUS PREFERENCES
  // ==========================================
  strictMls         Boolean      @default(true)
  alertsActive      Boolean      @default(false)
  alertTier         String       @default("Tier 1 & Tier 2")
  alertKeywords     String?      
  autoSendEmail     Boolean      @default(false)

  jobs              Job[]
  history           RunHistory[]
  applications Application[]
  notifications Notification[]
}

model Job {
  id              String   @id @default(cuid())
  
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role            String
  company         String
  loc             String
  salary          String
  skills          String
  desc            String?
  url             String
  score           Int
  tier            Int
  applied         Boolean  @default(false)
  status          String?  @default("applied") 
  applications Application[]
  
  // Job Meta
  jobType         String   @default("full-time") // "full-time", "internship", "locum"
  isMlscnApproved Boolean  @default(false)       // Critical for internships
  listingDetails  Json     @default("{}")
  
  // Employer / B2B Relations
  source          String?
  lastSeenAt      DateTime?
  isDirectPost    Boolean   @default(false)      // True if an employer posted it directly
  employerId      String?   
  employer        Employer? @relation(fields: [employerId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model RunHistory {
  id        String   @id @default(cuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  matches   Int
  t1Count   Int
  trigger   String
  status    String
  createdAt DateTime @default(now())
}

// ==========================================
// EMAIL VERIFICATION & OUTBOX QUEUE
// ==========================================

model VerificationToken {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailQueue {
  id         String   @id @default(cuid())
  emailTo    String
  subject    String
  htmlBody   String
  status     String   @default("PENDING") // PENDING, FAILED, SENT
  retryCount Int      @default(0)
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SalaryReport {
  id         String   @id @default(uuid())
  ownerKey   String?  @unique
  role       String
  location   String
  salary     Int      // Stored as a raw integer (e.g., 350000)
  experience String   // e.g., "1-3 years"
  submittedAt DateTime @default(now())
  // We do not link this to the User ID to ensure anonymity
}

model CpdEvent {
  id        String   @id @default(cuid())
  title     String
  location  String?
  date      String?  
  cpdUnits  Int?
  url       String?  @unique // Ensures we don't scrape the same link twice
  isManual  Boolean  @default(false) // Distinguishes scraped vs admin entry
  createdAt DateTime @default(now())
}

model MlscnNews {
  id        String   @id @default(cuid())
  title     String
  date      String?
  excerpt   String?
  url       String?  @unique
  source    String   @default("MLSCN")
  createdAt DateTime @default(now())
}

// ==========================================
// 🚀 NEW EMPLOYER MODEL (Phase 3 B2B)
// ==========================================
model Employer {
  id            String   @id @default(cuid())
  verificationStatus String @default("unsubmitted")
  verificationDetails Json @default("{}")
  verificationRevision Int @default(0)
  verificationFeedback String?
  verificationReference String?
  verifiedAt DateTime?
  companyName   String   @unique
  email         String   @unique
  passwordHash  String
  contactName   String?
  isVerified    Boolean  @default(false) // You manually verify hospitals to prevent spam
  emailVerificationRequired Boolean @default(false) // Legacy accounts retain their existing access.
  emailVerifiedAt DateTime?
  jobs          Job[]    // A hospital can have many direct job postings
  createdAt     DateTime @default(now())
}

// Append-only decisions retain the evidence even after a submission is replaced.
model SafetyReview {
  id String @id @default(cuid())
  kind String
  subjectId String
  decision String
  reviewer String
  evidence Json
  createdAt DateTime @default(now())
  @@index([kind, subjectId, createdAt])
}

model JobReport {
  id String @id @default(cuid())
  jobId String
  reporterId String
  reason String
  details String
  status String @default("open")
  resolution String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@unique([jobId, reporterId])
  @@index([status, createdAt])
}

// 🚀 NEW: The ATS Junction Table (The Employer's Inbox)
model Application {
  // Server-captured private file references. Never expose in JSON responses.
  documentSelection Json?
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  // 🚀 ADD THIS LINE TO TRACK THE ATS STATUS
  status    String   @default("pending")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  // Prevents a scientist from applying to the same job twice
  @@unique([jobId, userId]) 
  // Interview details
  interviewDate String?   // e.g., "2026-06-12"
  interviewTime String?   // e.g., "14:00"
  interviewLoc  String?   // e.g., "Zoom" or "Abuja HQ"
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // The scientist receiving the notification
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
// Only a hash of each random session token is stored. Logout revokes it immediately.
model AuthSession {
  tokenHash String @id
  subjectId String
  role String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([subjectId, role])
  @@index([expiresAt])
}

model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
